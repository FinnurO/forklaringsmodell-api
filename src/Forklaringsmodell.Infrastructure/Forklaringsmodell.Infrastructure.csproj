<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Forklaringsmodell.Domain\Forklaringsmodell.Domain.csproj" />
    <ProjectReference Include="..\Forklaringsmodell.Application\Forklaringsmodell.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- EF Core Sqlite drar inn SQLitePCLRaw 2.1.11 transitivt. Alt til og med 2.1.11 har
         CVE-2025-6965 (høy, minnekorrupsjon i SQLite før 3.50.2), så versjonen løftes
         eksplisitt til 2.1.12. Gjaldt også før oppgraderingen, da med 2.1.6. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
